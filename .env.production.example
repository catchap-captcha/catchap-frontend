# 프론트 프로덕션 빌드 변수 — 프론트 VM(210.109.14.25)에서 .env 로 복사 후 값 채우기.
# docker compose 가 ${...} 치환에 이 파일을 읽어 빌드 인자로 넘긴다.
# 주의: Vite는 빌드 타임에 번들로 인라인 → 빌드할 때 값이 있어야 하고, 바꾸면 재빌드 필요.

# 백엔드 API base (/api/v1 없이 base만 — 클라이언트가 /api/v1 을 붙인다)
VITE_API_BASE_URL=https://api.catchap5.com

# 인앱 교육형 위젯 site key — 반드시 "클라우드 DB에서 발급한" edu 키.
# (로컬에서 만든 ck_edu_... 는 클라우드 DB에 없어 위젯 인증 실패)
# 시드 후 OPS 콘솔(운영자 로그인)에서 교육형 키를 발급해 여기에 넣는다.
VITE_CATCHAP_EDU_SITE_KEY=ck_edu_<클라우드에서_발급한_키>

# (선택) 행동데이터 수집용 외부 CatChap Guard 캡차 호스트 — 안 넣으면
# https://captcha.catchap5.com 기본값. 위 edu 키와는 완전히 별개 서비스다.
# 이 위젯은 URL 에 ?collect=<참여자코드> 를 단 사람에게만 뜬다(일반 사용자는 영향 없음).
# VITE_COLLECT_CAPTCHA_ORIGIN=https://captcha.catchap5.com

# 로그인 스텝업 캡차를 CatChap Guard(captcha.catchap5.com)로 바꾼다.
# 값이 `catchap` 일 때만 전환되고, 없거나 다르면 지금 동작(드래그 캡차 / forest) 그대로다.
#
# ⚠ 백엔드가 준비되기 전에는 켜지 말 것. Guard 토큰은 백엔드가 캡차 서버에
#   POST /api/verify-token 으로 물어봐야 유효해지는데, 지금 로그인 API 는
#   자기가 발급한 토큰만 알아본다. 켜면 로그인이 막힌다.
#   규약: ai-service/docs/SPEC_BACKEND_CAPTCHA_20260804.md
# VITE_LOGIN_CAPTCHA=catchap
