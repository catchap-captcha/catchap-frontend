# 프론트 VM — www.catchap5.com 자동 HTTPS → web(nginx) 컨테이너. apex는 www로 리다이렉트.
www.catchap5.com {
	# 캡차 API — GPU 박스 드래그 캡차(10.0.1.52:8000)로 넘긴다.
	# ★handle_path 를 쓰는 이유: /captcha-api 접두사를 떼야 한다.
	#   안 떼면 캡차 앱이 자기 SPA 폴백 HTML을 200으로 돌려줘서 붙이기 전과 증상이 똑같다.
	#   (/captcha-api/api/config → 200 text/html, /api/config → 200 application/json)
	handle_path /captcha-api/* {
		reverse_proxy 10.0.1.52:8000
	}

	# 나머지는 전부 기존대로 프론트 SPA
	handle {
		reverse_proxy web:80
	}

	encode gzip
}

catchap5.com {
	redir https://www.catchap5.com{uri} permanent
}

# 캡차 전용 호스트 — 루트 그대로 캡차 앱으로(2026-08-05, 전용 호스트 방식).
# handle_path 로 접두사 떼지 않는다: widget.js origin·/assets·/api 가 루트 기준이라
# 루트 그대로여야 위젯 UI가 뜬다(하위경로 /captcha-api 는 서버검증용으로만 유지).
captcha.catchap5.com {
	reverse_proxy 10.0.1.52:8000
	encode gzip
}
